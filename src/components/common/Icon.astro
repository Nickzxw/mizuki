---
/**
 * Icon 组件
 */

import BaseIcon from "./Icon/Icon.astro";
import type { IconProps } from "./Icon/types";

export interface Props extends IconProps {}

const {
	icon,
	class: className = "",
	style = "",
	size = "md",
	color,
	fallback = "●",
	loading = "lazy",
} = Astro.props;
---

<BaseIcon
	icon={icon}
	class={className}
	style={style}
	size={size}
	color={color}
	fallback={fallback}
	loading={loading}
/>
